def set_cycle_eta(eta_tk, eta_st, c2_st, tol=1e-9):
    global eta_gg_poly, eta_pt_poly, c_pt_exit
    c_pt_exit = c2_st
    for _ in range(100):
        ss = cycle(PI_K)
        d_tk, d_st = eta_tk - ss['eta_gg'], eta_st - ss['eta_pt']
        eta_gg_poly += d_tk
        eta_pt_poly += d_st
        if max(abs(d_tk), abs(d_st)) < tol:
            break
    return cycle(PI_K)

